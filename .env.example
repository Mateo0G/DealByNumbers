# Copy to .env and fill in. .env is loaded automatically by the CLI.

# Required: your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use. Trivially swappable.
# Defaults to claude-sonnet-5 if unset. The --model flag overrides this.
CLAUDE_MODEL=claude-sonnet-5

# Optional: email every generated PDF to a recipient over SMTP.
# If SMTP_HOST/SMTP_USER/SMTP_PASSWORD are all set, the web app's background job
# mails a copy of the one-pager after rendering. If unset, that step is skipped
# (the PDF is still generated and downloadable). For Gmail, SMTP_PASSWORD must be
# an App Password, not your normal login password
# (https://support.google.com/accounts/answer/185833).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@example.com        # optional; defaults to SMTP_USER
# MAIL_TO=mateo.ghercioiu@gmail.com  # optional; defaults to mateo.ghercioiu@gmail.com

# Optional: where the web app stores in-flight job status + finished PDFs, and
# how long (seconds) to keep them before sweeping. Defaults to a temp dir with a
# 6-hour TTL, which is fine on Railway's ephemeral disk.
# JOB_STORE_DIR=/tmp/dbn_jobs
# JOB_TTL_SECONDS=21600
