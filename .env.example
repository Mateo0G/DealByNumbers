# Copy to .env and fill in. .env is loaded automatically by the CLI.

# Required: your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use. Trivially swappable.
# Defaults to claude-sonnet-5 if unset. The --model flag overrides this.
CLAUDE_MODEL=claude-sonnet-5

# Optional: email a copy of every generated PDF. Two transports are supported;
# if neither is configured, the email step is skipped (the PDF is still
# generated and downloadable). MAIL_TO overrides the recipient for either one.
# MAIL_TO=mateo.ghercioiu@gmail.com  # optional; defaults to mateo.ghercioiu@gmail.com

# --- Option A: Resend (RECOMMENDED on Railway) --------------------------------
# Sends over HTTPS (port 443), so it works where outbound SMTP is blocked (a
# Railway SMTP send fails with "Network is unreachable"). Get a key at
# https://resend.com. With the default onboarding@resend.dev sender and NO
# verified domain, Resend only delivers to your Resend account's own email — so
# sign up with the same address as MAIL_TO. Verify a domain to send anywhere and
# set RESEND_FROM to an address on it.
# RESEND_API_KEY=re_...
# RESEND_FROM=onboarding@resend.dev   # optional; verified-domain sender once you have one

# --- Option B: SMTP (works locally; blocked on Railway) -----------------------
# Used only when RESEND_API_KEY is not set. For Gmail, SMTP_PASSWORD must be an
# App Password, not your normal login password
# (https://support.google.com/accounts/answer/185833).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@example.com           # optional; defaults to SMTP_USER

# Optional: where the web app stores in-flight job status + finished PDFs, and
# how long (seconds) to keep them before sweeping. Defaults to a temp dir with a
# 6-hour TTL, which is fine on Railway's ephemeral disk.
# JOB_STORE_DIR=/tmp/dbn_jobs
# JOB_TTL_SECONDS=21600
